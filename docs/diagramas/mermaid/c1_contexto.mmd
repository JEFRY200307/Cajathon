flowchart TB
    AN["<b>Analista de riesgos / negocios</b><br/><i>[Persona]</i><br/>Revisa cartera en riesgo, define reglas y KPIs, aprueba estrategias"]:::person
    SUP["<b>Jefe de riesgos</b><br/><i>[Persona]</i><br/>Segunda aprobación (4-eyes), límites y kill switch"]:::person
    ASE["<b>Asesor de negocios</b><br/><i>[Persona]</i><br/>Recibe visitas y llamadas agendadas"]:::person
    CLI["<b>Microempresario</b><br/><i>[Persona · usuario indirecto]</i><br/>Recibe alertas, recomendaciones y ofertas"]:::person

    WN["<b>WENANCE.AI</b><br/><i>[Sistema de software]</i><br/>Plataforma agéntica que anticipa el riesgo climático por negocio,<br/>genera estrategias preventivas y las ejecuta con supervisión humana y guardrails"]:::system

    CLIMA["<b>SENAMHI · ENFEN</b><br/><i>[Sistema externo]</i><br/>Pronósticos, avisos y comunicados oficiales"]:::ext
    SIGRID["<b>CENEPRED · SIGRID · INEI</b><br/><i>[Sistema externo]</i><br/>Capas de peligro y límites distritales"]:::ext
    CORE["<b>Core bancario Caja Trujillo</b><br/><i>[Sistema externo · sandbox en hackathon]</i><br/>Créditos, cuotas, reprogramaciones, expedientes"]:::ext
    CRM["<b>CRM / agenda de asesores</b><br/><i>[Sistema externo]</i>"]:::ext
    MSG["<b>Canales SMS / WhatsApp</b><br/><i>[Sistema externo]</i>"]:::ext
    LLM["<b>Proveedor de LLM</b><br/><i>[Sistema externo · API]</i><br/>Recibe solo datos seudonimizados"]:::ext
    SEG["<b>Aseguradora</b><br/><i>[Sistema externo]</i><br/>Microseguros y seguros paramétricos"]:::ext

    AN -- "Configura reglas, aprueba / rechaza / modifica<br/>[HTTPS]" --> WN
    SUP -- "Aprueba 4-eyes, activa kill switch<br/>[HTTPS]" --> WN
    WN -- "Asigna visitas / llamadas" --> CRM
    CRM -. "Agenda" .-> ASE
    WN -- "Envía alertas preventivas" --> MSG
    MSG -. "SMS / WhatsApp" .-> CLI
    CLIMA -- "Pronósticos y alertas [API / archivos]" --> WN
    SIGRID -- "Capas geoespaciales [WMS / GeoJSON]" --> WN
    WN -- "Lee cartera; ejecuta acciones autorizadas<br/>[API, mínimo privilegio]" --> CORE
    WN -- "Prompts seudonimizados<br/>[HTTPS, tool calling]" --> LLM
    WN -- "Solicita cotización / oferta" --> SEG
