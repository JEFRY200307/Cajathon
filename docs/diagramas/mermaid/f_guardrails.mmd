flowchart TB
    s(["Acción del plan<br/>(A1–A7)"]):::ai --> k{"¿Kill switch<br/>activo?"}:::guard
    k -- "Sí" --> ms["Modo seguro: suspender<br/>y solo recomendar (M2)"]:::guard
    k -- "No" --> w{"¿Acción en lista<br/>blanca?"}:::guard
    w -- "No" --> blk["BLOQUEAR + escalar"]:::guard
    w -- "Sí" --> el{"¿Cumple elegibilidad?<br/>consentimiento · atraso · reglas"}:::guard
    el -- "No" --> blk
    el -- "Sí" --> eq{"¿Respeta equidad?<br/>no negar crédito por zona"}:::guard
    eq -- "No" --> blk
    eq -- "Sí" --> lm{"¿Dentro de límites?<br/>monto · cliente · día · agencia · % cartera"}:::guard
    lm -- "No" --> fe{"¿Escalable a 4-eyes?"}:::human
    fe -- "Sí" --> sup["Pendiente aprobación<br/>del jefe de riesgos"]:::human
    fe -- "No" --> blk
    lm -- "Sí" --> cf{"¿Confianza<br/>suficiente?"}:::comp
    cf -- "Baja" --> m3["Exigir aprobación<br/>humana (M3)"]:::human
    cf -- "OK" --> rk{"Riesgo de la acción"}:::comp
    rk -- "Bajo: A1 A2 A3" --> m4["M4 · ejecución automática"]:::ok
    rk -- "Medio / alto: A4 A5 A6" --> m3
    rk -- "A7" --> m2["M2 · solo recomendación"]:::ai
    m3 -- "Aprobada" --> dry
    sup -- "Aprobada" --> dry
    m4 --> dry["Dry run + llave de<br/>idempotencia"]:::comp
    dry --> ex["Ejecutar en lotes pequeños<br/>(rehidratar PII solo aquí)"]:::ok
    ex -- "Error" --> rb["Rollback"]:::guard
    ex -- "OK" --> au[("Auditoría M5")]:::db
    blk --> au
    rb --> au
